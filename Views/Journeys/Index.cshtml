@model IntelligentProgrammingPlatform.ViewModels.Submissions.AttemptJourneyViewModel
@{ ViewData["Title"] = L["Journey_Title"]; }
<div class="page-heading"><div><p class="eyebrow">@L["Journey_Eyebrow"]</p><h1>@L["Journey_Title"]</h1><p>@Model.TaskTitle · @L["Journey_Count", Model.TotalAttempts]</p></div>
    @if (Model.IsPublished) { <a class="btn btn-primary" asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.TaskSlug">@L["Journey_BackEditor"]</a> }
    else { <a class="btn btn-outline-secondary" asp-controller="Submissions" asp-action="My">@L["Common_MySubmissions"]</a> }
</div>
<partial name="_AttemptJourney" model="Model" />
@if (Model.PageCount > 1)
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4" aria-label="@L["Journey_Pages"]">
        @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-slug="@Model.TaskSlug" asp-route-page="@(Model.Page - 1)">@L["Journey_Earlier"]</a> }
        <span class="small text-muted">@L["Journey_Page", Model.Page, Model.PageCount]</span>
        @if (Model.Page < Model.PageCount) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-slug="@Model.TaskSlug" asp-route-page="@(Model.Page + 1)">@L["Journey_Later"]</a> }
    </nav>
}
