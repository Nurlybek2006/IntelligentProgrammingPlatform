@model IntelligentProgrammingPlatform.ViewModels.Submissions.AttemptJourneyViewModel
@{ ViewData["Title"] = "Attempt journey"; }
<div class="page-heading"><div><p class="eyebrow">Learn from each attempt</p><h1>Attempt journey</h1><p>@Model.TaskTitle · @Model.TotalAttempts official attempts</p></div>
    @if (Model.IsPublished) { <a class="btn btn-primary" asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.TaskSlug">Back to editor</a> }
    else { <a class="btn btn-outline-secondary" asp-controller="Submissions" asp-action="My">My submissions</a> }
</div>
<partial name="_AttemptJourney" model="Model" />
@if (Model.PageCount > 1)
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4" aria-label="Journey pages">
        @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-slug="@Model.TaskSlug" asp-route-page="@(Model.Page - 1)">Earlier attempts</a> }
        <span class="small text-muted">Page @Model.Page of @Model.PageCount</span>
        @if (Model.Page < Model.PageCount) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-slug="@Model.TaskSlug" asp-route-page="@(Model.Page + 1)">Later attempts</a> }
    </nav>
}
