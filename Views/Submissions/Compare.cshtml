@model IntelligentProgrammingPlatform.ViewModels.Submissions.SubmissionComparisonViewModel
@{
    ViewData["Title"] = "Compare attempts";
    Csp.EnableMonacoStyles();
}
<link rel="stylesheet" href="~/js/editor/code-editor.css" asp-append-version="true" />
<div class="page-heading"><div><p class="eyebrow">Understand what changed</p><h1>Compare attempts</h1><p>@Model.Current.TaskTitle</p></div></div>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-outline-secondary" asp-controller="Journeys" asp-action="Index" asp-route-slug="@Model.Current.TaskSlug">Back to journey</a>
    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.Current.Id">Back to submission</a>
</div>
<div class="comparison-info">
    <section class="panel"><h2 class="h5">Previous attempt · #@Model.Previous.Id</h2><span class="status-badge @Model.Previous.Status">@Model.Previous.Status</span><p class="small text-muted mt-2 mb-0">@Model.Previous.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC<br />@(Model.Previous.ExecutionTimeMs.HasValue ? Model.Previous.ExecutionTimeMs + " ms (test total)" : "Time not measured")</p></section>
    <section class="panel"><h2 class="h5">Current attempt · #@Model.Current.Id</h2><span class="status-badge @Model.Current.Status">@Model.Current.Status</span><p class="small text-muted mt-2 mb-0">@Model.Current.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC<br />@(Model.Current.ExecutionTimeMs.HasValue ? Model.Current.ExecutionTimeMs + " ms (test total)" : "Time not measured")</p></section>
</div>
<p class="small text-muted mt-3">Read-only C++ comparison. Removed and added lines are highlighted; on narrow screens the editor switches to an inline comparison.</p>
<div id="code-diff" class="code-diff" aria-label="Source changes between your attempts" hidden></div>
<div id="diff-fallback" class="comparison-info">
    <div><label for="previous-source" class="form-label">Previous source</label><textarea asp-for="Previous.SourceCode" id="previous-source" class="form-control source-fallback" readonly spellcheck="false"></textarea></div>
    <div><label for="current-source" class="form-label">Current source</label><textarea asp-for="Current.SourceCode" id="current-source" class="form-control source-fallback" readonly spellcheck="false"></textarea></div>
</div>
@section Scripts {
    <script type="module" src="~/js/editor/code-editor.js" asp-append-version="true"></script>
}
