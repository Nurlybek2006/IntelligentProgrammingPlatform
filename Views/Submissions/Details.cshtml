@using IntelligentProgrammingPlatform.Models.Enums
@model IntelligentProgrammingPlatform.ViewModels.Submissions.SubmissionDetailsViewModel
@{
    ViewData["Title"] = $"Submission #{Model.Id}";
    var statusTitle = Model.Status switch {
        SubmissionStatus.WrongAnswer => "Wrong answer", SubmissionStatus.CompilationError => "Compilation error",
        SubmissionStatus.RuntimeError => "Runtime error", SubmissionStatus.TimeLimitExceeded => "Time limit exceeded",
        SubmissionStatus.MemoryLimitExceeded => "Memory limit exceeded", SubmissionStatus.InternalError => "Internal error",
        _ => Model.Status.ToString()
    };
}
<a class="small" asp-action="My">← My submissions</a>
<a class="small ms-3" asp-controller="Journeys" asp-action="Index" asp-route-slug="@Model.TaskSlug">View attempt journey</a>
<div class="page-heading mt-3"><div><p class="eyebrow">Submission #@Model.Id</p><h1>@statusTitle</h1><p><a asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.TaskSlug">@Model.TaskTitle</a></p></div><a class="btn btn-primary" asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.TaskSlug">Return to editor →</a></div>
<section class="panel result-banner @Model.Status" aria-label="Submission overview">
    <dl class="result-facts mt-0">
        <div><dt>Status</dt><dd id="submission-status">@Model.Status</dd></div>
        <div><dt>Runtime</dt><dd>@Model.RuntimeName</dd></div>
        <div><dt>Passed / total</dt><dd>@Model.PassedTests / @Model.TotalTests</dd></div>
        <div><dt>Compilation</dt><dd>@(Model.CompileSucceeded.HasValue ? (Model.CompileSucceeded.Value ? "Succeeded" : "Failed") : "Not completed")</dd></div>
        <div><dt>Test container time</dt><dd>@(Model.ExecutionTimeMs.HasValue ? Model.ExecutionTimeMs + " ms (wall clock, total)" : "Not measured")</dd></div>
        <div><dt>Created (UTC)</dt><dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
        <div><dt>Started (UTC)</dt><dd>@(Model.StartedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Not started")</dd></div>
        <div><dt>Finished (UTC)</dt><dd>@(Model.FinishedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Not finished")</dd></div>
    </dl>
</section>
@if (Model.Status == SubmissionStatus.InternalError)
{
    <div class="alert alert-warning mt-3" role="status">Execution service is temporarily unavailable. Please try submitting again later.</div>
}
@if (Model.Status is SubmissionStatus.Pending or SubmissionStatus.Compiling or SubmissionStatus.Running)
{
    <p class="alert alert-info mt-3" role="status">Your submission is being checked. <a asp-action="Details" asp-route-id="@Model.Id">Refresh results</a>.</p>
}
<div class="result-grid">
    <div>
        @if (Model.CompileSucceeded == false)
        {
            <section class="panel mb-4"><h2 class="h5">Compilation failed</h2><p class="text-muted small">Read the first diagnostic, fix the syntax, then submit again.</p><pre class="test-data mb-0">@Model.CompilerOutput</pre></section>
        }
        <section aria-labelledby="tests-heading">
            <h2 id="tests-heading" class="h5 mb-3">Test results</h2>
            @if (Model.Results.Count == 0) { <div class="empty-state">No test results are available yet.</div> }
            @foreach (var result in Model.Results)
            {
                <section class="card test-result mb-3"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2"><h3 class="mb-0">@(result.IsHidden ? "Hidden test" : "Test") #@result.Number</h3><span class="status-badge @result.Status">@result.Status</span></div>
                    <p class="text-muted small">Time: @(result.ExecutionTimeMs.HasValue ? result.ExecutionTimeMs + " ms" : "Not measured")</p>
                    @if (result.IsHidden) { <p class="small text-muted mb-0">Only the result and timing are shown for this test.</p> }
                    else
                    {
                        <h4 class="h6 text-muted">Input</h4><pre class="test-data">@result.Input</pre>
                        <h4 class="h6 text-muted">Expected output</h4><pre class="test-data">@result.ExpectedOutput</pre>
                        <h4 class="h6 text-muted">Actual output</h4><pre class="test-data">@result.ActualOutput</pre>
                        @if (!string.IsNullOrEmpty(result.ErrorMessage)) { <h4 class="h6 text-muted">Diagnostic</h4><pre class="test-data">@result.ErrorMessage</pre> }
                    }
                </div></section>
            }
        </section>
    </div>
    <section class="panel ai-panel" aria-labelledby="ai-tutor-heading">
        <p class="eyebrow">Understand your next step</p>
        <h2 id="ai-tutor-heading">AI Tutor</h2>
        @if (TempData["AiMessage"] is string message) { <p class="alert alert-info" role="status">@message</p> }
        @if (Model.AiFeedback is { } feedback)
        {
            <h3>Summary</h3><p class="text-content">@feedback.Summary</p>
            <p class="small">Error category: <span class="badge bg-secondary">@feedback.ErrorCategory</span></p>
            <h3>Explanation</h3><div class="text-content mb-3">@feedback.Explanation</div>
            <h3>Hints</h3><ol class="hints">@foreach (var hint in feedback.Hints) { <li class="text-content">@hint</li> }</ol>
        }
        else if (Model.FinishedAt == null || Model.Status is SubmissionStatus.Pending or SubmissionStatus.Compiling or SubmissionStatus.Running)
        {
            <p class="text-muted">AI feedback is available after the submission finishes.</p>
        }
        else if (!Model.AiConfigured)
        {
            <p class="text-muted">AI feedback is not configured.</p>
        }
        else
        {
            <p>Analyze this submission to get hints.</p>
            <p class="small text-muted">Your code, task text and visible diagnostic data are sent to OpenAI. Hidden test contents are not sent. The tutor gives hints, not a final solution.</p>
            <form asp-action="Analyze" asp-route-id="@Model.Id" method="post" data-busy-form="Asking your tutor…">
                <button class="btn btn-primary" type="submit">Analyze with AI</button>
                <span class="d-block small mt-2" role="status"></span>
            </form>
        }
        <p class="small text-muted mt-4 mb-0">AI feedback can be mistaken. Verify changes by submitting code again.</p>
    </section>
</div>
<section class="mt-4" aria-labelledby="source-heading"><h2 id="source-heading" class="h5">Submitted source code</h2><pre class="source-code" tabindex="0"><code>@Model.SourceCode</code></pre></section>
