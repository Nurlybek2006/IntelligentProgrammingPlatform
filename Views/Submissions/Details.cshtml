@using IntelligentProgrammingPlatform.Models.Enums
@model IntelligentProgrammingPlatform.ViewModels.Submissions.SubmissionDetailsViewModel
@{
    ViewData["Title"] = L["Submission_Title", Model.Id];
    var statusTitle = T[$"Status_{Model.Status}"];
}
<a class="small" asp-action="My">@L["Submission_Back"]</a>
<a class="small ms-3" asp-controller="Journeys" asp-action="Index" asp-route-slug="@Model.TaskSlug">@L["Submission_Journey"]</a>
<div class="page-heading mt-3"><div><p class="eyebrow">@L["Submission_Title", Model.Id]</p><h1>@statusTitle</h1><p><a asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.TaskSlug">@Model.TaskTitle</a></p></div><a class="btn btn-primary" asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.TaskSlug">@L["Submission_Editor"]</a></div>
<section class="panel result-banner @Model.Status" aria-label="@L["Submission_Overview"]">
    <dl class="result-facts mt-0">
        <div><dt>@L["Common_Status"]</dt><dd id="submission-status" data-status="@Model.Status">@T[$"Status_{Model.Status}"]</dd></div>
        <div><dt>@L["Common_Runtime"]</dt><dd>@Model.RuntimeName</dd></div>
        <div><dt>@L["Common_PassedTotal"]</dt><dd>@Model.PassedTests / @Model.TotalTests</dd></div>
        <div><dt>@L["Common_Compilation"]</dt><dd>@(Model.CompileSucceeded.HasValue ? (Model.CompileSucceeded.Value ? L["Submission_Succeeded"] : L["Submission_Failed"]) : L["Submission_NotCompleted"])</dd></div>
        <div><dt>@L["Submission_ContainerTime"]</dt><dd>@(Model.ExecutionTimeMs.HasValue ? L["Submission_WallTime", Model.ExecutionTimeMs.Value] : L["Common_NotMeasured"])</dd></div>
        <div><dt>@L["Common_CreatedUtc"]</dt><dd>@Model.CreatedAt.ToString("G")</dd></div>
        <div><dt>@L["Submission_StartedUtc"]</dt><dd>@(Model.StartedAt?.ToString("G") ?? L["Submission_NotStarted"].Value)</dd></div>
        <div><dt>@L["Submission_FinishedUtc"]</dt><dd>@(Model.FinishedAt?.ToString("G") ?? L["Submission_NotFinished"].Value)</dd></div>
    </dl>
</section>
@if (Model.Status == SubmissionStatus.InternalError)
{
    <div class="alert alert-warning mt-3" role="status">@L["Submission_Unavailable"]</div>
}
@if (Model.Status is SubmissionStatus.Pending or SubmissionStatus.Compiling or SubmissionStatus.Running)
{
    <p class="alert alert-info mt-3" role="status">@L["Submission_Checking"] <a asp-action="Details" asp-route-id="@Model.Id">@L["Submission_Refresh"]</a>.</p>
}
<div class="result-grid">
    <div>
        @if (Model.CompileSucceeded == false)
        {
            <section class="panel mb-4"><h2 class="h5">@L["Submission_CompilationFailed"]</h2><p class="text-muted small">@L["Submission_CompilationHelp"]</p><pre class="test-data mb-0">@Model.CompilerOutput</pre></section>
        }
        <section aria-labelledby="tests-heading">
            <h2 id="tests-heading" class="h5 mb-3">@L["Submission_TestResults"]</h2>
            @if (Model.Results.Count == 0) { <div class="empty-state">@L["Submission_NoResults"]</div> }
            @foreach (var result in Model.Results)
            {
                <section class="card test-result mb-3"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2"><h3 class="mb-0">@L[result.IsHidden ? "Submission_HiddenTest" : "Submission_Test"] #@result.Number</h3><span class="status-badge @result.Status">@T[$"Status_{result.Status}"]</span></div>
                    <p class="text-muted small">@L["Common_TimeLabel", result.ExecutionTimeMs.HasValue ? L["Common_Milliseconds", result.ExecutionTimeMs.Value].Value : L["Common_NotMeasured"].Value]</p>
                    @if (result.IsHidden) { <p class="small text-muted mb-0">@L["Submission_HiddenHelp"]</p> }
                    else
                    {
                        <h4 class="h6 text-muted">@L["Common_Input"]</h4><pre class="test-data">@result.Input</pre>
                        <h4 class="h6 text-muted">@L["Common_ExpectedOutput"]</h4><pre class="test-data">@result.ExpectedOutput</pre>
                        <h4 class="h6 text-muted">@L["Submission_ActualOutput"]</h4><pre class="test-data">@result.ActualOutput</pre>
                        @if (!string.IsNullOrEmpty(result.ErrorMessage)) { <h4 class="h6 text-muted">@L["Submission_Diagnostic"]</h4><pre class="test-data">@result.ErrorMessage</pre> }
                    }
                </div></section>
            }
        </section>
    </div>
    <section class="panel ai-panel" aria-labelledby="ai-tutor-heading">
        <p class="eyebrow">@L["Ai_Eyebrow"]</p>
        <h2 id="ai-tutor-heading">@L["Ai_Title"]</h2>
        <p class="small text-muted">@L["Ai_LanguageHelp"]</p>
        @if (TempData["AiMessage"] is string message) { <p class="alert alert-info" role="status">@message</p> }
        @if (Model.AiFeedback is { } feedback)
        {
            <h3>@L["Ai_Summary"]</h3><p class="text-content">@feedback.Summary</p>
            <p class="small">@L["Ai_ErrorCategory"] <span class="badge bg-secondary">@T[$"AiCategory_{(feedback.ErrorCategory is "Compilation" or "Logic" or "Runtime" or "TimeLimit" or "Memory" or "OutputFormat" ? feedback.ErrorCategory : "Unknown")}"]</span></p>
            <h3>@L["Ai_Explanation"]</h3><div class="text-content mb-3">@feedback.Explanation</div>
            <h3>@L["Ai_ProgressiveHints"]</h3>
            <div class="hint-progress" role="status">
                <p id="hint-count">@L["Ai_RevealedCount", feedback.RevealedHintCount, feedback.AvailableHintCount]</p>
                <div class="hint-steps" aria-hidden="true">
                    @for (var i = 0; i < feedback.AvailableHintCount; i++)
                    {
                        <span class="hint-step @(i < feedback.RevealedHintCount ? "is-revealed" : "")">@(i < feedback.RevealedHintCount ? "●" : "○")</span>
                    }
                </div>
            </div>
            <ol class="hints">
                @for (var i = 0; i < feedback.Hints.Count; i++)
                {
                    <li class="text-content"><strong>@L["Ai_Hint", i + 1]</strong><p>@feedback.Hints[i]</p></li>
                }
            </ol>
            @if (feedback.CanRevealNext)
            {
                <p class="small text-muted">@L["Ai_TryFirst"]</p>
                <form asp-controller="HintReveals" asp-action="RevealNextHint" asp-route-id="@Model.Id" method="post" data-busy-form="@L["Ai_Revealing"]">
                    <button class="btn btn-outline-primary" type="submit">@L[feedback.AvailableHintCount - feedback.RevealedHintCount == 1 ? "Ai_RevealFinal" : "Ai_RevealNext"]</button>
                    <span class="d-block small mt-2" role="status"></span>
                </form>
                <p class="small text-muted mt-2">@L["Ai_RevealHelp"]</p>
            }
            else
            {
                <p class="small text-muted">@L[feedback.AvailableHintCount == 0 ? "Ai_NoHints" : "Ai_AllRevealed"]</p>
            }
        }
        else if (Model.FinishedAt == null || Model.Status is SubmissionStatus.Pending or SubmissionStatus.Compiling or SubmissionStatus.Running)
        {
            <p class="text-muted">@L["Ai_AfterFinish"]</p>
        }
        else if (!Model.AiConfigured)
        {
            <p class="text-muted">@L["Ai_NotConfigured"]</p>
        }
        else
        {
            <p>@L["Ai_AnalyzeText"]</p>
            <p class="small text-muted">@L["Ai_Disclosure"]</p>
            <form asp-action="Analyze" asp-route-id="@Model.Id" method="post" data-busy-form="@L["Ai_Asking"]">
                <button class="btn btn-primary" type="submit">@L["Ai_Analyze"]</button>
                <span class="d-block small mt-2" role="status"></span>
            </form>
        }
        <p class="small text-muted mt-4 mb-0">@L["Ai_Caution"]</p>
    </section>
</div>
<section class="mt-4" aria-labelledby="source-heading"><h2 id="source-heading" class="h5">@L["Submission_Source"]</h2><pre class="source-code" tabindex="0"><code>@Model.SourceCode</code></pre></section>
