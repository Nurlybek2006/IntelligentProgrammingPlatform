@using Microsoft.AspNetCore.Identity
@using IntelligentProgrammingPlatform.ViewModels.Account
@inject UserManager<ApplicationUser> UserManager
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
@if (User.Identity?.IsAuthenticated == true)
{
    var currentUser = await UserManager.GetUserAsync(User);
    <details class="nav-dropdown account-nav">
    <summary class="nav-control user-control" aria-current="@(controller is "Account" or "Favorites" || ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "page" : null)"><partial name="_UserAvatar" model="@(new UserAvatarViewModel { DisplayName = currentUser?.DisplayName, AvatarPath = currentUser?.AvatarPath, Small = true })" /><span class="display-name">@currentUser?.DisplayName</span><span class="chevron" aria-hidden="true"></span></summary>
    <div class="nav-dropdown-menu">
    <p class="dropdown-label">@L["Account_YourAccount"]</p>
    <a class="dropdown-item" aria-current="@(controller == "Account" && action == "Profile" ? "page" : null)" asp-area="" asp-controller="Account" asp-action="Profile">@T["Nav_Profile"]</a>
    <a class="dropdown-item" aria-current="@(controller == "Favorites" ? "page" : null)" asp-area="" asp-controller="Favorites" asp-action="Index">@T["Favorites_Title"]</a>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <a class="dropdown-item" aria-current="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "page" : null)" asp-area="Admin" asp-controller="Home" asp-action="Index">@T["Nav_Admin"]</a>
    }
    <div class="dropdown-divider"></div>
    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item">@T["Nav_Logout"]</button></form>
    </div></details>
}
else
{
    <div class="account-nav guest-actions"><a class="nav-control" aria-current="@(controller == "Account" && action == "Login" ? "page" : null)" asp-area="" asp-controller="Account" asp-action="Login">@T["Nav_Login"]</a>
    <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">@T["Nav_Register"]</a></div>
}
