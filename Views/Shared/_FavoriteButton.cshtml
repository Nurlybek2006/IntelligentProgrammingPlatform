@model IntelligentProgrammingPlatform.ViewModels.Tasks.FavoriteButtonViewModel
@if (User.Identity?.IsAuthenticated == true)
{
    var label = T[Model.IsFavorite ? "Favorite_Remove" : "Favorite_Add"];
    <form asp-area="" asp-controller="Favorites" asp-action="@(Model.IsFavorite ? "Remove" : "Add")" method="post" class="favorite-form">
        <input type="hidden" name="taskId" value="@Model.TaskId" />
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <button type="submit" class="btn btn-outline-secondary @(Model.Compact ? "btn-sm" : "")" aria-label="@label" title="@label" aria-pressed="@(Model.IsFavorite ? "true" : "false")"><span aria-hidden="true">@(Model.IsFavorite ? "★" : "☆")</span>@if (!Model.Compact) { <span> @label</span> }</button>
    </form>
}
