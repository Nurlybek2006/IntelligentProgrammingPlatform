@model ErrorViewModel
@{
    Layout = "_ErrorLayout";
    var title = Model.StatusCode switch { 403 => "Access denied", 404 => "Page not found", 500 => "Something went wrong", _ => "We couldn't complete that request" };
    ViewData["Title"] = title;
}
<section class="panel error-page">
    <p class="error-number" aria-hidden="true">@Model.StatusCode</p>
    <h1>@title</h1>
    <p class="text-muted">@(Model.StatusCode == 404 ? "This page may have moved or is no longer available." : Model.StatusCode == 403 ? "You do not have permission to access this page." : "Please return to the task catalog and try again. If the problem continues, contact the administrator.")</p>
    @if (Model.ShowRequestId) { <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p> }
    <a asp-area="" asp-controller="Tasks" asp-action="Index" class="btn btn-primary">Back to tasks</a>
</section>
