@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var inAdmin = area == "Admin";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csp-nonce" content="@Csp.Nonce" />
    <meta name="description" content="@T["App_Description"]" />
    <title>@ViewData["Title"] · @T["App_Name"]</title>
    <script type="importmap" nonce="@Csp.Nonce"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">@T["Nav_Skip"]</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-xxl" aria-label="@T["Nav_Main"]">
            <div class="container-fluid app-width">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@T["Nav_HomeLabel"]"><span class="brand-mark" aria-hidden="true">&lt;/&gt;</span><span>@T["App_Brand"]<span class="brand-subtitle">@T["App_Subtitle"]</span></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="@T["Nav_Toggle"]"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Tasks" && !inAdmin ? "page" : null)" asp-area="" asp-controller="Tasks" asp-action="Index">@T["Nav_Tasks"]</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Submissions" ? "page" : null)" asp-area="" asp-controller="Submissions" asp-action="My">@T["Nav_Submissions"]</a></li>
                            <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Progress" ? "page" : null)" asp-area="" asp-controller="Progress" asp-action="Index">@T["Nav_Progress"]</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Leaderboard" && !inAdmin ? "page" : null)" asp-area="" asp-controller="Leaderboard" asp-action="Index">@T["Nav_Leaderboard"]</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                    <partial name="_CultureSelector" />
                </div>
            </div>
        </nav>
    </header>
    <div class="app-width page-shell @(inAdmin ? "admin-shell" : "")">
        @if (inAdmin)
        {
            <nav class="admin-nav" aria-label="@T["Nav_AdminLabel"]">
                <span class="eyebrow">@T["Nav_Administration"]</span>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" ? "page" : null)">@T["Nav_Overview"]</a>
                <a asp-area="Admin" asp-controller="Topics" asp-action="Index" aria-current="@(controller == "Topics" ? "page" : null)">@T["Nav_Topics"]</a>
                <a asp-area="Admin" asp-controller="ProgrammingTasks" asp-action="Index" aria-current="@(controller == "ProgrammingTasks" ? "page" : null)">@T["Nav_Tasks"]</a>
                <a asp-area="Admin" asp-controller="TestCases" asp-action="Index" aria-current="@(controller == "TestCases" ? "page" : null)">@T["Nav_TestCases"]</a>
            </nav>
        }
        <main id="main-content" tabindex="-1">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success" role="status">@success</div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="site-footer">
        <div class="app-width d-flex flex-wrap justify-content-between gap-2">
            <span>@T["App_Name"] <span class="footer-separator">/</span> @T["Footer_Learn"]</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">@T["Footer_Privacy"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
