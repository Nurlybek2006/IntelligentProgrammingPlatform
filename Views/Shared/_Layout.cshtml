@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var inAdmin = area == "Admin";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csp-nonce" content="@Csp.Nonce" />
    <meta name="description" content="Practice C++, learn from test results and AI hints, and follow your programming progress." />
    <title>@ViewData["Title"] · Intelligent Programming Platform</title>
    <script type="importmap" nonce="@Csp.Nonce"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-xl" aria-label="Main navigation">
            <div class="container-fluid app-width">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Intelligent Programming Platform home"><span class="brand-mark" aria-hidden="true">&lt;/&gt;</span><span>Intelligent<span class="brand-subtitle">Programming Platform</span></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Tasks" && !inAdmin ? "page" : null)" asp-area="" asp-controller="Tasks" asp-action="Index">Tasks</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Submissions" ? "page" : null)" asp-area="" asp-controller="Submissions" asp-action="My">My submissions</a></li>
                            <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Progress" ? "page" : null)" asp-area="" asp-controller="Progress" asp-action="Index">Progress</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" aria-current="@(controller == "Leaderboard" && !inAdmin ? "page" : null)" asp-area="" asp-controller="Leaderboard" asp-action="Index">Leaderboard</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="app-width page-shell @(inAdmin ? "admin-shell" : "")">
        @if (inAdmin)
        {
            <nav class="admin-nav" aria-label="Admin navigation">
                <span class="eyebrow">Administration</span>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" ? "page" : null)">Overview</a>
                <a asp-area="Admin" asp-controller="Topics" asp-action="Index" aria-current="@(controller == "Topics" ? "page" : null)">Topics</a>
                <a asp-area="Admin" asp-controller="ProgrammingTasks" asp-action="Index" aria-current="@(controller == "ProgrammingTasks" ? "page" : null)">Tasks</a>
                <a asp-area="Admin" asp-controller="TestCases" asp-action="Index" aria-current="@(controller == "TestCases" ? "page" : null)">Test cases</a>
            </nav>
        }
        <main id="main-content" tabindex="-1">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success" role="status">@success</div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="site-footer">
        <div class="app-width d-flex flex-wrap justify-content-between gap-2">
            <span>Intelligent Programming Platform <span class="footer-separator">/</span> Learn by solving.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy &amp; data</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
