@model IntelligentProgrammingPlatform.ViewModels.Account.ProfileEditViewModel
@{ ViewData["Title"] = T["Profile_Edit"]; }
<a asp-action="Profile" class="back-link">← @L["Account_Profile"]</a>
<section class="panel profile-editor"><p class="eyebrow">@L["Account_YourAccount"]</p><h1>@T["Profile_Edit"]</h1>
    <p class="text-muted">@T["Profile_EditHelp"]</p>
    <form asp-action="EditProfile" method="post" enctype="multipart/form-data" data-busy-form="@T["Profile_Saving"]">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-4"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" maxlength="100" autocomplete="nickname" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Avatar" class="form-label">@T["Profile_UploadAvatar"]</label><input asp-for="Avatar" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" aria-describedby="avatar-help" /><p id="avatar-help" class="form-text">@T["Avatar_Help"]</p></div>
        <div class="profile-actions"><button type="submit" class="btn btn-primary">@T["Profile_Save"]</button><a asp-action="Profile" class="btn btn-outline-secondary">@T["Profile_Cancel"]</a></div><p role="status" class="small mt-2"></p>
    </form>
</section>
