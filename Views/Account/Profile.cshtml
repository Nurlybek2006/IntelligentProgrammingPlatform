@model IntelligentProgrammingPlatform.ViewModels.Account.ProfileViewModel
@{ ViewData["Title"] = "Profile"; }
<section class="auth-card">
<p class="eyebrow">Your account</p><h1>Profile</h1><p class="text-muted mb-4">Your display name appears on the leaderboard. Your email stays private.</p>
<dl>
    <dt class="text-muted small">Display name</dt><dd class="mb-3">@Model.DisplayName</dd>
    <dt class="text-muted small">Email</dt><dd class="mb-3">@Model.Email</dd>
    <dt class="text-muted small">Joined (UTC)</dt><dd class="mb-3">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt class="text-muted small">Roles</dt><dd class="mb-4">@string.Join(", ", Model.Roles)</dd>
</dl>
<div class="d-flex gap-2 flex-wrap"><a asp-controller="Tasks" asp-action="Index" class="btn btn-primary">Browse tasks</a><a asp-controller="Progress" asp-action="Index" class="btn btn-outline-secondary">My progress</a></div>
</section>
