@model IntelligentProgrammingPlatform.ViewModels.Account.ProfileViewModel
@{ ViewData["Title"] = "Profile"; }
<h1>Profile</h1>
<dl class="row">
    <dt class="col-sm-3">Display name</dt><dd class="col-sm-9">@Model.DisplayName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Joined (UTC)</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt class="col-sm-3">Roles</dt><dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
</dl>
<a asp-controller="Tasks" asp-action="Index" class="btn btn-primary">Browse tasks</a>
