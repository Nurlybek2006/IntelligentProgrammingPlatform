@model IntelligentProgrammingPlatform.ViewModels.Progress.ProgressViewModel
@{ ViewData["Title"] = L["Common_MyProgress"]; }
<style nonce="@Csp.Nonce">
    @for (var i = 0; i < Model.Difficulties.Count; i++)
    {
        @:.difficulty-progress-@i { width: @(Math.Clamp(Model.Difficulties[i].Percentage, 0, 100))%; }
    }
</style>
<div class="page-heading"><div><p class="eyebrow">@L["Progress_Eyebrow"]</p><h1>@L["Common_MyProgress"]</h1><p>@L["Progress_PublishedSolved"] <strong id="published-progress">@Model.PublishedSolvedTasks / @Model.PublishedTasks</strong></p></div><a class="btn btn-primary" asp-controller="Tasks" asp-action="Index">@L["Progress_KeepPracticing"]</a></div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3"><div class="panel metric-card"><h2>@L["Progress_AllSolved"]</h2><strong id="solved-tasks">@Model.SolvedTasks</strong></div></div>
    <div class="col-sm-6 col-lg-3"><div class="panel metric-card"><h2>@L["Progress_Completed"]</h2><strong id="total-submissions">@Model.TotalSubmissions</strong></div></div>
    <div class="col-sm-6 col-lg-3"><div class="panel metric-card"><h2>@L["Progress_Accepted"]</h2><strong id="accepted-submissions">@Model.AcceptedSubmissions</strong></div></div>
    <div class="col-sm-6 col-lg-3"><div class="panel metric-card"><h2>@L["Progress_CompilationErrors"]</h2><strong id="compilation-errors">@Model.CompilationErrors</strong></div></div>
    <div class="col-sm-6 col-lg-4"><div class="panel metric-card"><h2>@L["Progress_SuccessPercentage"]</h2><strong id="success-rate">@Model.SuccessRate.ToString("0.0")%</strong><p class="small text-muted mb-0 mt-2">@L["Progress_SuccessHelp"]</p></div></div>
    <div class="col-sm-6 col-lg-4"><div class="panel metric-card"><h2>@L["Progress_AverageTime"]</h2><strong id="average-solve-time">@(Model.AverageSolveSeconds.HasValue ? L["Progress_Minutes", (Model.AverageSolveSeconds.Value / 60).ToString("0.0")] : L["Progress_NotAvailable"])</strong><p class="small text-muted mb-0 mt-2">@L["Progress_TimeHelp"]</p></div></div>
    <div class="col-sm-6 col-lg-4"><div class="panel metric-card accent"><h2>@L["Progress_Rating"]</h2><strong id="rating-score">@Model.Score</strong><p class="small text-muted mb-0 mt-2">@L["Progress_RatingHelp"]</p></div></div>
</div>
<div class="row g-4">
    <section class="col-lg-5" aria-labelledby="difficulty-heading"><div class="panel h-100">
        <h2 id="difficulty-heading" class="h5 mb-4">@L["Progress_ByDifficulty"]</h2>
        @for (var i = 0; i < Model.Difficulties.Count; i++)
        {
            var group = Model.Difficulties[i];
            <div class="mb-4">
                <p class="d-flex justify-content-between mb-2"><span class="difficulty @group.Name">@T[$"Difficulty_{group.Name}"]</span><strong>@group.Solved / @group.Total</strong></p>
                <div class="progress" role="progressbar" aria-label="@L["Progress_DifficultyLabel", T[$"Difficulty_{group.Name}"].Value]" aria-valuenow="@group.Solved" aria-valuemin="0" aria-valuemax="@Math.Max(1, group.Total)">
                    <div class="progress-bar difficulty-progress-@i">@(group.Percentage > 0 ? group.Percentage + "%" : "")</div>
                </div>
            </div>
        }
        <p class="small text-muted mb-0">@L["Progress_RepeatedHelp"]</p>
    </div></section>
    <section class="col-lg-7" aria-labelledby="topic-heading"><div class="panel h-100">
        <h2 id="topic-heading" class="h5 mb-4">@L["Progress_ByTopic"]</h2>
        @if (Model.Topics.Count == 0) { <p class="text-muted">@L["Progress_NoTopics"]</p> }
        else
        {
            <div class="table-responsive" role="region" aria-label="@L["Progress_ByTopic"]" tabindex="0">
            <table class="table"><thead><tr><th scope="col">@L["Common_Topic"]</th><th scope="col">@L["Progress_Solved"]</th><th scope="col">@L["Progress_PublishedTasks"]</th></tr></thead><tbody>
            @foreach (var topic in Model.Topics) { <tr><td>@topic.Name</td><td>@topic.Solved</td><td>@topic.Total</td></tr> }
            </tbody></table></div>
        }
        <p class="small text-muted mb-0">@L["Progress_HistoryHelp"]</p>
    </div></section>
</div>
<p class="small text-muted mt-3">@L["Progress_SolvingTimeHelp"]</p>
<partial name="_LearningMap" model="Model.LearningMap" />
<section aria-labelledby="recent-heading">
    <div class="section-heading"><h2 id="recent-heading">@L["Progress_Recent"]</h2><a asp-controller="Submissions" asp-action="My">@L["Progress_AllSubmissions"]</a></div>
    @if (Model.Recent.Count == 0) { <div class="empty-state"><h3>@L["Progress_EmptyHeading"]</h3><p><a asp-controller="Tasks" asp-action="Index">@L["Progress_ChooseTask"]</a> @L["Progress_GetStarted"]</p></div> }
    else { <partial name="_RecentSubmissions" model="Model.Recent" /> }
</section>
