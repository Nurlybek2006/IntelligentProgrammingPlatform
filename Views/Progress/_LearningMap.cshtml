@using System.Globalization
@model IntelligentProgrammingPlatform.ViewModels.Progress.LearningInsightsViewModel
<section id="learning-map" aria-labelledby="learning-map-heading" class="mt-5">
    <div class="section-heading"><div><p class="eyebrow">@L["Map_Eyebrow"]</p><h2 id="learning-map-heading">@L["Map_Title"]</h2></div></div>
    <p class="text-muted">@L["Map_Intro"]</p>
    <details class="learning-guide mb-4">
        <summary>@L["Map_GuideTitle"]</summary>
        <p class="small mt-3">@L["Map_Formula"]</p>
        <p class="small mb-0">@L["Map_LevelsHelp", T["Strength_NotStarted"].Value, T["Strength_Exploring"].Value, T["Strength_Strong"].Value, T["Strength_Developing"].Value, T["Strength_NeedsPractice"].Value]</p>
    </details>
    <h3 class="h5 mb-3">@L["Map_TopicStrength"]</h3>
    @if (Model.Topics.Count == 0)
    {
        <div class="empty-state">@L["Map_Empty"]</div>
    }
    <div class="learning-topic-grid">
        @foreach (var topic in Model.Topics)
        {
            var score = topic.StrengthScore.ToString("0.0", CultureInfo.InvariantCulture);
            <article class="panel learning-topic" data-topic-id="@topic.TopicId" data-strength="@score" data-label="@topic.Level">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><h4 class="h5 mb-0">@topic.Name</h4><span class="learning-label">@T[$"Strength_{topic.Level}"]</span></div>
                <p class="learning-strength"><strong>@topic.StrengthScore.ToString("0.0")%</strong> <span class="small text-muted">@L["Map_Strength"]</span></p>
                <progress class="learning-meter" value="@score" max="100" aria-label="@L["Map_StrengthLabel", topic.Name]">@topic.StrengthScore.ToString("0.0")%</progress>
                <dl class="learning-facts">
                    <div><dt>@L["Map_SolvedPublished"]</dt><dd>@topic.SolvedTasks / @topic.PublishedTasks</dd></div>
                    <div><dt>@L["Map_CompletedAttempts"]</dt><dd>@topic.CompletedSubmissions</dd></div>
                    <div><dt>@L["Map_Completion"]</dt><dd>@((topic.CompletionRate * 100).ToString("0.0"))%</dd></div>
                    <div><dt>@L["Map_Success"]</dt><dd>@((topic.SubmissionSuccessRate * 100).ToString("0.0"))%</dd></div>
                </dl>
                <p class="small mb-0">@L["Map_FrequentIssue"] <strong>@T[$"ErrorPattern_{topic.MostFrequentIssue}"]</strong></p>
                @if (topic.PublishedTasks == 0) { <p class="small text-muted mt-2 mb-0">@L["Map_NoPublished"]</p> }
                <details class="small mt-3">
                    <summary>@L["Map_Breakdown"]</summary>
                    <dl class="learning-facts">
                        <div><dt>@T["Status_Accepted"]</dt><dd>@topic.AcceptedSubmissions</dd></div>
                        <div><dt>@T["ErrorPattern_Compilation"]</dt><dd>@topic.CompilationErrors</dd></div>
                        <div><dt>@T["ErrorPattern_WrongAnswer"]</dt><dd>@topic.WrongAnswers</dd></div>
                        <div><dt>@T["ErrorPattern_Runtime"]</dt><dd>@topic.RuntimeErrors</dd></div>
                        <div><dt>@T["ErrorPattern_TimeLimit"]</dt><dd>@topic.TimeLimitErrors</dd></div>
                        <div><dt>@T["ErrorPattern_MemoryLimit"]</dt><dd>@topic.MemoryLimitErrors</dd></div>
                    </dl>
                </details>
            </article>
        }
    </div>
    <div class="row g-4 mt-1">
        <section class="col-lg-6" aria-labelledby="error-patterns-heading"><div class="panel h-100">
            <h3 id="error-patterns-heading" class="h5">@L["Map_ErrorPatterns"]</h3>
            <p class="small text-muted">@L["Map_ErrorHelp"]</p>
            @foreach (var pattern in Model.ErrorPatterns)
            {
                <div class="learning-pattern">
                    <div class="d-flex justify-content-between gap-3"><span>@T[$"ErrorPattern_{pattern.Name}"]</span><strong>@pattern.Count</strong></div>
                    <progress class="learning-meter" value="@pattern.Count" max="@Math.Max(1, Model.ErrorPatterns.Max(item => item.Count))" aria-label="@L["Map_ErrorLabel", T[$"ErrorPattern_{pattern.Name}"].Value]">@pattern.Count</progress>
                </div>
            }
            @if (Model.ErrorPatterns.All(item => item.Count == 0)) { <p class="small text-muted mb-0">@L["Map_NoErrors"]</p> }
        </div></section>
        <section class="col-lg-6" aria-labelledby="ai-patterns-heading"><div class="panel h-100">
            <h3 id="ai-patterns-heading" class="h5">@L["Map_AiPatterns"]</h3>
            <p class="small text-muted">@L["Map_AiHelp"]</p>
            @foreach (var pattern in Model.AiPatterns)
            {
                <div class="learning-pattern">
                    <div class="d-flex justify-content-between gap-3"><span>@T[$"AiCategory_{pattern.Name}"]</span><strong>@pattern.Count</strong></div>
                    <progress class="learning-meter" value="@pattern.Count" max="@Math.Max(1, Model.AiPatterns.Max(item => item.Count))" aria-label="@L["Map_AiLabel", T[$"AiCategory_{pattern.Name}"].Value]">@pattern.Count</progress>
                </div>
            }
            @if (Model.AiPatterns.Count == 0) { <p class="text-muted mb-0">@L["Map_NoAi"]</p> }
        </div></section>
    </div>
    <section id="practice-next" class="panel practice-next mt-4" aria-labelledby="practice-next-heading">
        <p class="eyebrow">@L["Map_PracticeNext"]</p><h3 id="practice-next-heading" class="h4">@L["Map_Recommendation"]</h3>
        @if (Model.PracticeNext is { } next)
        {
            <h4 class="h5">@next.Title</h4>
            <p>@L["Map_Topic"] @next.TopicName · <span class="difficulty @next.Difficulty">@T[$"Difficulty_{next.Difficulty}"]</span></p>
            <p class="text-muted">@L["Map_Reason", next.TopicName, T[$"Strength_{next.Level}"].Value, next.SolvedTasks, next.PublishedTasks]</p>
            <a id="practice-next-link" class="btn btn-primary" asp-controller="Tasks" asp-action="Details" asp-route-slug="@next.Slug">@L["Map_PracticeButton"]</a>
        }
        else if (Model.AllPublishedSolved)
        {
            <p class="mb-0">@L["Map_AllSolved"]</p>
        }
        else
        {
            <p class="mb-0">@L["Map_NoPractice"]</p>
        }
    </section>
</section>
