@model IntelligentProgrammingPlatform.ViewModels.Home.HomeViewModel
@{ ViewData["Title"] = L["Home_Title"]; }
<section class="hero">
    <div>
        <p class="eyebrow">@L["Home_Eyebrow"]</p>
        <h1>@L["Home_Heading"]<br /><span>@L["Home_HeadingAccent"]</span></h1>
        <p class="hero-copy">@L["Home_Intro"]</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Tasks" asp-action="Index">@L[User.Identity?.IsAuthenticated == true ? "Home_Continue" : "Home_Start"] <span aria-hidden="true">→</span></a>
            <a class="btn btn-outline-secondary" asp-controller="Leaderboard" asp-action="Index">@L["Home_ExploreLeaderboard"]</a>
        </div>
        <p class="hero-note">@L["Home_Note"]</p>
    </div>
    <div class="learning-loop" aria-label="@L["Home_JourneyLabel"]">
        <div class="loop-title"><span>@L["Home_LoopTitle"]</span><span aria-hidden="true">&lt;/&gt;</span></div>
        <div class="loop-step"><span class="loop-number" aria-hidden="true">01</span><div><strong>@L["Home_StepTask"]</strong><p>@L["Home_StepTaskText"]</p></div></div>
        <div class="loop-step"><span class="loop-number" aria-hidden="true">02</span><div><strong>@L["Home_StepResult"]</strong><p>@L["Home_StepResultText"]</p></div></div>
        <div class="loop-step"><span class="loop-number" aria-hidden="true">03</span><div><strong>@L["Home_StepLearn"]</strong><p>@L["Home_StepLearnText"]</p></div></div>
    </div>
</section>
@if (User.Identity?.IsAuthenticated == true)
{
    <section aria-labelledby="snapshot-heading">
        <div class="section-heading"><h2 id="snapshot-heading">@L["Home_Snapshot"]</h2><a asp-controller="Progress" asp-action="Index">@L["Home_ViewProgress"]</a></div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6"><div class="panel metric-card"><h2>@L["Common_SolvedTasks"]</h2><strong id="home-solved">@Model.SolvedTasks</strong></div></div>
            <div class="col-sm-6"><div class="panel metric-card accent"><h2>@L["Home_YourScore"]</h2><strong id="home-score">@Model.Score</strong></div></div>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <div class="empty-state"><h3>@L["Home_EmptyHeading"]</h3><p>@L["Home_EmptyText"]</p></div>
        }
        else
        {
            <partial name="_RecentSubmissions" model="Model.Recent" />
        }
    </section>
}
<section aria-labelledby="features-heading">
    <div class="section-heading"><h2 id="features-heading">@L["Home_Features"]</h2></div>
    <div class="feature-grid">
        <div class="panel"><span class="feature-number" aria-hidden="true">@L["Home_PracticeTag"]</span><h3>@L["Home_TasksFeature"]</h3><p>@L["Home_TasksFeatureText"]</p></div>
        <div class="panel"><span class="feature-number" aria-hidden="true">@L["Home_CheckTag"]</span><h3>@L["Home_ExecutionFeature"]</h3><p>@L["Home_ExecutionFeatureText"]</p></div>
        <div class="panel"><span class="feature-number" aria-hidden="true">@L["Home_UnderstandTag"]</span><h3>@L["Home_AiFeature"]</h3><p>@L["Home_AiFeatureText"]</p></div>
        <div class="panel"><span class="feature-number" aria-hidden="true">@L["Home_GrowTag"]</span><h3>@L["Home_ProgressFeature"]</h3><p>@L["Home_ProgressFeatureText"]</p></div>
    </div>
</section>
