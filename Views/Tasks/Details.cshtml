@model IntelligentProgrammingPlatform.ViewModels.Tasks.TaskDetailsViewModel
@{ ViewData["Title"] = Model.Title; }
<a asp-controller="Tasks" asp-action="Index">Back to tasks</a>
<h1 class="mt-3">@Model.Title</h1>
<p><span class="badge bg-secondary">@Model.TopicName</span> <span class="badge bg-primary">@Model.Difficulty</span></p>
<p>Time limit: <strong>@Model.TimeLimitMs ms</strong> · Memory limit: <strong>@Model.MemoryLimitMb MB</strong></p>
<div class="text-content mb-4">@Model.Description</div>
<h2>Examples</h2>
@if (Model.Examples.Count == 0)
{
    <p>No examples are available.</p>
}
@for (var index = 0; index < Model.Examples.Count; index++)
{
    var example = Model.Examples[index];
    <section class="card mb-3">
        <div class="card-body">
            <h3 class="h5">Example @(index + 1)</h3>
            <h4 class="h6">Input</h4><pre class="test-data">@example.Input</pre>
            <h4 class="h6">Expected output</h4><pre class="test-data">@example.ExpectedOutput</pre>
        </div>
    </section>
}
<section class="mt-4" aria-labelledby="solution-heading">
    <h2 id="solution-heading">Your solution</h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="~/Views/Tasks/_SubmissionForm.cshtml" model="Model.Submission" />
    }
    else
    {
        <p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Login</a>
            or <a asp-controller="Account" asp-action="Register">register</a> to write and submit a C++ solution.</p>
    }
</section>
@section Scripts {
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_ValidationScriptsPartial" />
        <script type="module" src="~/js/editor/code-editor.js" asp-append-version="true"></script>
    }
}
