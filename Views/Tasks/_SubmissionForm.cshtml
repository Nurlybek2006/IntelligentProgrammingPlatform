@using System.Security.Claims
@model IntelligentProgrammingPlatform.ViewModels.Submissions.SubmitViewModel
@{ Csp.EnableMonacoStyles(); }
<link rel="stylesheet" href="~/js/editor/code-editor.css" asp-append-version="true" />
<form asp-controller="Submissions" asp-action="Submit" method="post" id="submission-form"
      data-draft-key="ipp-source-@User.FindFirstValue(ClaimTypes.NameIdentifier)-@Model.ProgrammingTaskId"
      data-validation-failed="@(!ViewData.ModelState.IsValid ? "true" : "false")"
      data-run-url="@Url.Action("Run", "CustomRuns")"
      data-editor-label="@T["Editor_AriaLabel"]" data-source-limit="@T["Validation_SourceLimit"]"
      data-submit-progress="@T["Editor_Submitting"]">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="ProgrammingTaskId" type="hidden" />
    <div class="mb-3">
        <label asp-for="RuntimeId" class="form-label"></label>
        <select asp-for="RuntimeId" asp-items="Model.Runtimes" class="form-select"></select>
        <span asp-validation-for="RuntimeId" class="text-danger"></span>
    </div>
    <label asp-for="SourceCode" class="form-label"></label>
    <textarea asp-for="SourceCode" class="form-control source-fallback" spellcheck="false" aria-describedby="source-help"></textarea>
    <div id="code-editor" class="code-editor" hidden></div>
    <span asp-validation-for="SourceCode" class="text-danger"></span>
    <p id="source-help" class="form-text">@L["Editor_SourceHelp"]</p>
    <div class="custom-input-panel mb-3">
        <label for="CustomInput" class="form-label">@L["Run_CustomInput"]</label>
        <textarea id="CustomInput" name="CustomInput" class="form-control custom-input" rows="4" maxlength="32768" spellcheck="false" aria-describedby="custom-input-help"></textarea>
        <p id="custom-input-help" class="form-text mb-0">@L["Run_InputHelp"]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" id="run-code" disabled="@(Model.Runtimes.Count == 0)">@L["Run_Button"]</button>
        <button type="submit" class="btn btn-primary" id="submit-code" disabled="@(Model.Runtimes.Count == 0)">@L["Submit_Button"]</button>
    </div>
    <p class="form-text">@L["Submit_Help"]</p>
    <span id="submission-progress" class="ms-2" role="status"></span>
    @if (Model.Runtimes.Count == 0)
    {
        <p class="text-warning mt-2">@L["Editor_NoRuntime"]</p>
    }
</form>
<section id="custom-run-result" class="custom-run-result mt-4" aria-labelledby="run-result-heading" hidden
         data-temporary="@T["Run_Temporary"]" data-check-input="@T["Run_CheckInput"]" data-limits="@T["Run_Limits"]"
         data-running="@T["Run_Running"]" data-sign-in="@T["Run_SignIn"]" data-reload="@T["Run_Reload"]"
         data-retry="@T["Run_Retry"]" data-interrupted="@T["Run_Interrupted"]"
         data-time-format="@T["Run_TimeFormat"]" data-time-unmeasured="@T["Run_TimeUnmeasured"]"
         data-success-summary="@T["Run_SuccessSummary"]" data-status-success="@T["Status_Success"]"
         data-status-compilation-error="@T["Status_CompilationError"]" data-status-runtime-error="@T["Status_RuntimeError"]"
         data-status-time-limit-exceeded="@T["Status_TimeLimitExceeded"]" data-status-memory-limit-exceeded="@T["Status_MemoryLimitExceeded"]"
         data-status-internal-error="@T["Status_InternalError"]">
    <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><h3 id="run-result-heading" class="h5 mb-0">@L["Run_Result"]</h3><span id="run-status" class="status-badge" role="status" aria-live="polite"></span></div>
    <p id="run-summary" class="small text-muted mt-2"></p>
    <p id="run-time" class="small text-muted"></p>
    <h4 class="h6">@L["Common_Output"]</h4><pre id="run-output" class="test-data" tabindex="0"></pre>
    <div id="run-error-panel" hidden><h4 class="h6">@L["Run_Diagnostic"]</h4><pre id="run-error" class="test-data" tabindex="0"></pre></div>
    <div id="run-compiler-panel" hidden><h4 class="h6">@L["Common_CompilerOutput"]</h4><pre id="run-compiler" class="test-data" tabindex="0"></pre></div>
</section>
