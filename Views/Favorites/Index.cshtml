@model List<IntelligentProgrammingPlatform.ViewModels.Tasks.TaskListItemViewModel>
@using IntelligentProgrammingPlatform.ViewModels.Tasks
@{ ViewData["Title"] = T["Favorites_Title"]; }
<div class="page-heading"><div><p class="eyebrow">@L["Account_YourAccount"]</p><h1>@T["Favorites_Title"]</h1></div><a asp-controller="Tasks" asp-action="Index" class="btn btn-outline-primary">@L["Common_Tasks"]</a></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><p>@T["Favorites_Empty"]</p><a asp-controller="Tasks" asp-action="Index">@L["Tasks_ShowAll"]</a></div>
}
else
{
    <div class="favorite-cards">
    @foreach (var task in Model)
    {
        <article class="panel favorite-card"><div class="d-flex justify-content-between gap-2"><span class="difficulty @task.Difficulty">@T[$"Difficulty_{task.Difficulty}"]</span><partial name="_FavoriteButton" model="@(new FavoriteButtonViewModel(task.Id, true, true))" /></div>
            <h2 class="h4 mt-3"><a asp-controller="Tasks" asp-action="Details" asp-route-slug="@task.Slug">@task.Title</a></h2><p class="text-muted">@task.TopicName</p>
            @if (task.IsSolved) { <span class="solved-badge">@L["Tasks_Solved"]</span> } else { <span class="text-muted">@L["Tasks_ToExplore"]</span> }
        </article>
    }
    </div>
}
