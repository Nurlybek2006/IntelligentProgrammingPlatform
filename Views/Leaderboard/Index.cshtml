@model IntelligentProgrammingPlatform.ViewModels.Leaderboard.LeaderboardViewModel
@{ ViewData["Title"] = L["Common_Leaderboard"]; }
<div class="page-heading"><div><p class="eyebrow">@L["Leaderboard_Eyebrow"]</p><h1>@L["Common_Leaderboard"]</h1><p>@L["Leaderboard_Intro"]</p></div></div>
<div class="d-flex flex-wrap gap-2 mb-4"><span class="difficulty Easy">@L["Leaderboard_Points", T["Difficulty_Easy"].Value, 100]</span><span class="difficulty Medium">@L["Leaderboard_Points", T["Difficulty_Medium"].Value, 200]</span><span class="difficulty Hard">@L["Leaderboard_Points", T["Difficulty_Hard"].Value, 300]</span></div>
<p class="small text-muted">@L["Leaderboard_ScoreHelp"]</p>
@if (Model.Rows.Count == 0)
{
    <div class="empty-state"><h2>@L["Leaderboard_EmptyHeading"]</h2><p>@L["Leaderboard_EmptyText"]</p><a class="btn btn-primary" asp-controller="Tasks" asp-action="Index">@L["Common_BrowseTasks"]</a></div>
}
else
{
    <div class="table-responsive" role="region" aria-label="@L["Leaderboard_Region"]" tabindex="0">
    <table class="table table-striped"><thead><tr><th scope="col">@L["Leaderboard_Rank"]</th><th scope="col">@L["Common_DisplayName"]</th><th scope="col">@L["Common_SolvedTasks"]</th><th scope="col">@L["Leaderboard_Accepted"]</th><th scope="col">@L["Leaderboard_Completed"]</th><th scope="col">@L["Leaderboard_Success"]</th><th scope="col">@L["Leaderboard_Score"]</th></tr></thead><tbody>
    @foreach (var row in Model.Rows)
    {
        <tr class="@(row.IsCurrentUser ? "table-primary" : "")"><td><span class="rank-marker @(row.Rank <= 3 ? "rank-" + row.Rank : "")">@row.Rank</span></td><td>@row.DisplayName @if (row.IsCurrentUser) { <span class="badge bg-primary">@L["Leaderboard_You"]</span> }</td><td>@row.SolvedTasks</td><td>@row.SuccessfulSubmissions</td><td>@row.TotalSubmissions</td><td>@row.SuccessRate.ToString("0.0")%</td><td><strong>@row.Score</strong></td></tr>
    }
    </tbody></table>
    </div>
}
<nav class="d-flex gap-2 align-items-center" aria-label="@L["Leaderboard_Pages"]">
    @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)">@L["Common_Previous"]</a> }
    @if (Model.Page > 1 || Model.HasNextPage) { <span class="text-muted">@L["Common_Page", Model.Page]</span> }
    @if (Model.HasNextPage) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)">@L["Common_Next"]</a> }
</nav>
