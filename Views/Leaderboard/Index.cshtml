@model IntelligentProgrammingPlatform.ViewModels.Leaderboard.LeaderboardViewModel
@{ ViewData["Title"] = "Leaderboard"; }
<h1>Leaderboard</h1>
<p>Each solved task scores once: Easy 100 · Medium 200 · Hard 300.</p>
<div class="table-responsive">
<table class="table table-striped"><thead><tr><th>Rank</th><th>Display name</th><th>Solved tasks</th><th>Accepted</th><th>Completed</th><th>Success rate</th><th>Score</th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{
    <tr class="@(row.IsCurrentUser ? "table-primary" : "")"><td>@row.Rank</td><td>@row.DisplayName @if (row.IsCurrentUser) { <span class="badge bg-primary">You</span> }</td><td>@row.SolvedTasks</td><td>@row.SuccessfulSubmissions</td><td>@row.TotalSubmissions</td><td>@row.SuccessRate.ToString("0.0")%</td><td>@row.Score</td></tr>
}
</tbody></table>
</div>
@if (Model.Rows.Count == 0) { <p>No leaderboard entries yet.</p> }
<nav aria-label="Leaderboard pages">
    @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)">Previous</a> }
    @if (Model.HasNextPage) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a> }
</nav>
