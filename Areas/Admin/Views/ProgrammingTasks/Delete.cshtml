@model ProgrammingTask
@{ ViewData["Title"] = A["Task_Delete"]; }
<h1>@A["Task_Delete"]</h1>
<p class="alert alert-warning" role="note">@A["Task_DeletePrompt", Model.Title]</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">@A["Task_Delete"]</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">@A["Button_Cancel"]</a>
</form>
