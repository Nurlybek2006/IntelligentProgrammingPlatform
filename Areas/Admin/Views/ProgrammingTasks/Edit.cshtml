@model ProgrammingTaskFormViewModel
@{ ViewData["Title"] = A["Task_Edit"]; }
<h1>@A["Task_Edit"]</h1>
<form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">@A["Button_Save"]</button>
    <a asp-action="Index" class="btn btn-secondary">@A["Button_Cancel"]</a>
</form>
@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
