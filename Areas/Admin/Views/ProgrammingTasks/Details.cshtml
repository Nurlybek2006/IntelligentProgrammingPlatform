@model ProgrammingTask
@{ ViewData["Title"] = Model.Title; }
<a asp-action="Index">@A["Task_Back"]</a>
<h1 class="mt-3">@Model.Title</h1>
<p>@Model.Topic.Name · @T[$"Difficulty_{Model.Difficulty}"] · @A[Model.IsPublished ? "Field_Published" : "Field_Unpublished"]</p>
<dl class="row">
    <dt class="col-sm-3">@A["Field_Slug"]</dt><dd class="col-sm-9">@Model.Slug</dd>
    <dt class="col-sm-3">@A["Field_Limits"]</dt><dd class="col-sm-9">@A["Limits_Value", Model.TimeLimitMs, Model.MemoryLimitMb]</dd>
    <dt class="col-sm-3">@A["Field_CreatedUtc"]</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>
</dl>
<div class="text-content mb-3">@Model.Description</div>
<p>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">@A["Task_Edit"]</a>
    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">@A["Task_Delete"]</a>
    @if (Model.IsPublished)
    {
        <a class="btn btn-outline-secondary" asp-area="" asp-controller="Tasks" asp-action="Details" asp-route-slug="@Model.Slug">@A["Task_PublicPage"]</a>
    }
</p>
<h2>@A["TestCases"]</h2>
<p><a class="btn btn-outline-primary" asp-controller="TestCases" asp-action="Create" asp-route-taskId="@Model.Id">@A["TestCase_Add"]</a>
<a class="btn btn-outline-secondary" asp-controller="TestCases" asp-action="Index" asp-route-taskId="@Model.Id">@A["TestCase_Manage"]</a></p>
<div class="table-responsive" role="region" aria-label="@A["Records_Label"]" tabindex="0"><table class="table">
<thead><tr><th scope="col">@A["Field_Order"]</th><th scope="col">@A["Field_Input"]</th><th scope="col">@A["Field_ExpectedOutput"]</th><th scope="col">@A["Field_Hidden"]</th><th scope="col">@A["Field_Actions"]</th></tr></thead>
<tbody>
@foreach (var test in Model.TestCases)
{
    <tr><td>@test.Order</td><td><pre class="test-data">@test.Input</pre></td><td><pre class="test-data">@test.ExpectedOutput</pre></td><td>@A[test.IsHidden ? "Yes" : "No"]</td><td><a asp-controller="TestCases" asp-action="Edit" asp-route-id="@test.Id">@A["Button_Edit"]</a> | <a asp-controller="TestCases" asp-action="Delete" asp-route-id="@test.Id" class="text-danger">@A["Button_Delete"]</a></td></tr>
}
</tbody>
</table></div>
