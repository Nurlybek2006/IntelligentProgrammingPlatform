@model IReadOnlyList<ProgrammingTask>
@{ ViewData["Title"] = A["Task_Manage"]; }
<a asp-controller="Home" asp-action="Index">@A["Admin"]</a>
<h1>@A["Tasks"]</h1>
<p><a class="btn btn-primary" asp-action="Create">@A["Task_Create"]</a></p>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>@A["Records_Empty"]</h2><p>@A["Records_EmptyHelp"]</p></div>
}
else
{
<div class="table-responsive" role="region" aria-label="@A["Records_Label"]" tabindex="0"><table class="table">
    <thead><tr><th scope="col">@A["Field_Title"]</th><th scope="col">@A["Field_Topic"]</th><th scope="col">@A["Field_Difficulty"]</th><th scope="col">@A["Field_Published"]</th><th scope="col">@A["Field_Actions"]</th></tr></thead>
    <tbody>
    @foreach (var task in Model)
    {
        <tr><td><a asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td><td>@task.Topic.Name</td><td>@T[$"Difficulty_{task.Difficulty}"]</td><td>@A[task.IsPublished ? "Yes" : "No"]</td><td>
            <a asp-action="Edit" asp-route-id="@task.Id">@A["Button_Edit"]</a> |
            <a asp-action="Delete" asp-route-id="@task.Id" class="text-danger">@A["Button_Delete"]</a>
        </td></tr>
    }
    </tbody>
</table></div>

}
