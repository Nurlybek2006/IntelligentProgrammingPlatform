@model IReadOnlyList<ProgrammingTask>
@{ ViewData["Title"] = "Manage tasks"; }
<a asp-controller="Home" asp-action="Index">Admin</a>
<h1>Programming tasks</h1>
<p><a class="btn btn-primary" asp-action="Create">Create task</a></p>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>No records to show yet.</h2><p>Use the controls above to add a record or choose another task.</p></div>
}
else
{
<div class="table-responsive" role="region" aria-label="Management records" tabindex="0"><table class="table">
    <thead><tr><th scope="col">Title</th><th scope="col">Topic</th><th scope="col">Difficulty</th><th scope="col">Published</th><th scope="col">Actions</th></tr></thead>
    <tbody>
    @foreach (var task in Model)
    {
        <tr><td><a asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td><td>@task.Topic.Name</td><td>@task.Difficulty</td><td>@(task.IsPublished ? "Yes" : "No")</td><td>
            <a asp-action="Edit" asp-route-id="@task.Id">Edit</a> |
            <a asp-action="Delete" asp-route-id="@task.Id">Delete</a>
        </td></tr>
    }
    </tbody>
</table></div>

}
