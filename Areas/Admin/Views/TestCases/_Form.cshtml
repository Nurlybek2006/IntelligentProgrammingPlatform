@model TestCaseFormViewModel
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="ProgrammingTaskId" type="hidden" />
<p>@A["TestCase_TaskLabel"] <strong>@ViewBag.TaskTitle</strong></p>
<div class="mb-3"><label asp-for="Input" class="form-label"></label><textarea asp-for="Input" class="form-control font-monospace" rows="5"></textarea><span asp-validation-for="Input" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ExpectedOutput" class="form-label"></label><textarea asp-for="ExpectedOutput" class="form-control font-monospace" rows="5"></textarea><span asp-validation-for="ExpectedOutput" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Order" class="form-label"></label><input asp-for="Order" class="form-control" /><span asp-validation-for="Order" class="text-danger"></span></div>
<div class="form-check mb-3"><input asp-for="IsHidden" class="form-check-input" /><label asp-for="IsHidden" class="form-check-label"></label><div class="form-text">@A["TestCase_HiddenHelp"]</div></div>
