@model IReadOnlyList<TestCase>
@{ ViewData["Title"] = A["TestCases"]; }
<a asp-controller="ProgrammingTasks" asp-action="Index">@A["Tasks"]</a>
<h1>@A["TestCases"]</h1>
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6"><label for="taskId" class="form-label">@A["Field_Task"]</label><select name="taskId" id="taskId" asp-items="ViewBag.Tasks" class="form-select"><option value="">@A["Task_All"]</option></select></div>
    <div class="col-auto d-flex align-items-end"><button class="btn btn-secondary" type="submit">@A["Button_Filter"]</button></div>
</form>
@if (ViewBag.TaskId != null)
{
    <p><a class="btn btn-primary" asp-action="Create" asp-route-taskId="@ViewBag.TaskId">@A["TestCase_Add"]</a> <a asp-controller="ProgrammingTasks" asp-action="Details" asp-route-id="@ViewBag.TaskId">@A["Task_Details"]</a></p>
}
else
{
    <p>@A["Task_ChooseForTest"]</p>
}
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>@A["Records_Empty"]</h2><p>@A["Records_EmptyHelp"]</p></div>
}
else
{
<div class="table-responsive" role="region" aria-label="@A["Records_Label"]" tabindex="0"><table class="table">
<thead><tr><th scope="col">@A["Field_Task"]</th><th scope="col">@A["Field_Order"]</th><th scope="col">@A["Field_Input"]</th><th scope="col">@A["Field_ExpectedOutput"]</th><th scope="col">@A["Field_Hidden"]</th><th scope="col">@A["Field_Actions"]</th></tr></thead>
<tbody>
@foreach (var test in Model)
{
    <tr><td>@test.ProgrammingTask.Title</td><td>@test.Order</td><td><pre class="test-data">@test.Input</pre></td><td><pre class="test-data">@test.ExpectedOutput</pre></td><td>@A[test.IsHidden ? "Yes" : "No"]</td><td><a asp-action="Edit" asp-route-id="@test.Id">@A["Button_Edit"]</a> | <a asp-action="Delete" asp-route-id="@test.Id" class="text-danger">@A["Button_Delete"]</a></td></tr>
}
</tbody>
</table></div>

}
