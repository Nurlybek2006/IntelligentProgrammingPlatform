@model TestCaseFormViewModel
@{ ViewData["Title"] = A["TestCase_Create"]; }
<h1>@A["TestCase_Create"]</h1>
<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">@A["Button_Save"]</button>
    <a asp-action="Index" asp-route-taskId="@Model.ProgrammingTaskId" class="btn btn-secondary">@A["Button_Cancel"]</a>
</form>
@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
