@model TestCaseFormViewModel
@{ ViewData["Title"] = "Create test case"; }
<h1>Create test case</h1>
<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-action="Index" asp-route-taskId="@Model.ProgrammingTaskId" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
