@model IReadOnlyList<Topic>
@{ ViewData["Title"] = "Topics"; }
<a asp-controller="Home" asp-action="Index">Admin</a>
<h1>Topics</h1>
<p><a class="btn btn-primary" asp-action="Create">Create topic</a></p>
<div class="table-responsive"><table class="table">
    <thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var topic in Model)
    {
        <tr><td>@topic.Name</td><td>@topic.Description</td><td>
            <a asp-action="Edit" asp-route-id="@topic.Id">Edit</a> |
            <a asp-action="Delete" asp-route-id="@topic.Id">Delete</a>
        </td></tr>
    }
    </tbody>
</table></div>
