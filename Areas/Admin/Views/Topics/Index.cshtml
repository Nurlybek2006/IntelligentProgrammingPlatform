@model IReadOnlyList<Topic>
@{ ViewData["Title"] = "Topics"; }
<a asp-controller="Home" asp-action="Index">Admin</a>
<h1>Topics</h1>
<p><a class="btn btn-primary" asp-action="Create">Create topic</a></p>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>No records to show yet.</h2><p>Use the controls above to add a record or choose another task.</p></div>
}
else
{
<div class="table-responsive" role="region" aria-label="Management records" tabindex="0"><table class="table">
    <thead><tr><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Actions</th></tr></thead>
    <tbody>
    @foreach (var topic in Model)
    {
        <tr><td>@topic.Name</td><td>@topic.Description</td><td>
            <a asp-action="Edit" asp-route-id="@topic.Id">Edit</a> |
            <a asp-action="Delete" asp-route-id="@topic.Id">Delete</a>
        </td></tr>
    }
    </tbody>
</table></div>

}
