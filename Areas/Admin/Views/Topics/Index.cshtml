@model IReadOnlyList<Topic>
@{ ViewData["Title"] = A["Topics"]; }
<a asp-controller="Home" asp-action="Index">@A["Admin"]</a>
<h1>@A["Topics"]</h1>
<p><a class="btn btn-primary" asp-action="Create">@A["Topic_Create"]</a></p>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>@A["Records_Empty"]</h2><p>@A["Records_EmptyHelp"]</p></div>
}
else
{
<div class="table-responsive" role="region" aria-label="@A["Records_Label"]" tabindex="0"><table class="table">
    <thead><tr><th scope="col">@A["Field_Name"]</th><th scope="col">@A["Field_Description"]</th><th scope="col">@A["Field_Actions"]</th></tr></thead>
    <tbody>
    @foreach (var topic in Model)
    {
        <tr><td>@topic.Name</td><td>@topic.Description</td><td>
            <a asp-action="Edit" asp-route-id="@topic.Id">@A["Button_Edit"]</a> |
            <a asp-action="Delete" asp-route-id="@topic.Id" class="text-danger">@A["Button_Delete"]</a>
        </td></tr>
    }
    </tbody>
</table></div>

}
