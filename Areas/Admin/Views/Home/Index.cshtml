@{ ViewData["Title"] = "Admin"; }
<div class="page-heading"><div><p class="eyebrow">Catalog management</p><h1>Admin workspace</h1><p>Prepare clear tasks, reliable examples and meaningful tests for students.</p></div></div>
<div class="admin-actions">
    <a class="panel" asp-controller="Topics" asp-action="Index"><span class="feature-number" aria-hidden="true">01 / ORGANIZE</span><h2 class="h4">Topics →</h2><p>Group practice tasks into useful learning areas.</p></a>
    <a class="panel" asp-controller="ProgrammingTasks" asp-action="Index"><span class="feature-number" aria-hidden="true">02 / PUBLISH</span><h2 class="h4">Programming tasks →</h2><p>Edit descriptions, difficulty, limits and publication state.</p></a>
    <a class="panel" asp-controller="TestCases" asp-action="Index"><span class="feature-number" aria-hidden="true">03 / VERIFY</span><h2 class="h4">Test cases →</h2><p>Manage visible examples and protected hidden tests.</p></a>
</div>
<section class="panel mt-4">
    <h2 class="h4">Leaderboard maintenance</h2>
    <p class="text-muted">Recalculate scores and counts from submission history after catalog changes. Existing submissions are preserved.</p>
    @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
    <form asp-controller="Leaderboard" asp-action="Rebuild" method="post" data-busy-form="Rebuilding leaderboard…"><button class="btn btn-outline-primary" type="submit">Rebuild leaderboard</button><span class="d-block small mt-2" role="status"></span></form>
</section>
