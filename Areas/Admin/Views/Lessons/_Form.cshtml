@model LessonFormViewModel
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" maxlength="200" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" maxlength="200" aria-describedby="slug-help" /><span asp-validation-for="Slug" class="text-danger"></span><div id="slug-help" class="form-text">@A["Lesson_SlugHelp"]</div></div>
<div class="mb-3"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" class="form-control" rows="3" maxlength="1000"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" class="form-control" rows="12" maxlength="50000" aria-describedby="content-help"></textarea><span asp-validation-for="Content" class="text-danger"></span><div id="content-help" class="form-text">@A["Lesson_ContentHelp"]</div></div>
<div class="mb-3"><label asp-for="CodeExample" class="form-label"></label><textarea asp-for="CodeExample" class="form-control font-monospace" rows="9" maxlength="16000" spellcheck="false" aria-describedby="code-help"></textarea><span asp-validation-for="CodeExample" class="text-danger"></span><div id="code-help" class="form-text">@A["Lesson_CodeHelp"]</div></div>
<div class="mb-3"><label asp-for="CodeLanguage" class="form-label"></label><select asp-for="CodeLanguage" class="form-select"><option value="text">@A["Lesson_PlainText"]</option><option value="cpp">C++</option><option value="python">Python</option></select><span asp-validation-for="CodeLanguage" class="text-danger"></span></div>
<div class="row">
    <div class="col-md-8 mb-3"><label asp-for="TopicId" class="form-label"></label><select asp-for="TopicId" asp-items="Model.Topics" class="form-select"><option value="">@A["Task_SelectTopic"]</option></select><span asp-validation-for="TopicId" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="Order" class="form-label"></label><input asp-for="Order" class="form-control" min="1" aria-describedby="order-help" /><span asp-validation-for="Order" class="text-danger"></span><div id="order-help" class="form-text">@A["Lesson_OrderHelp"]</div></div>
</div>
<div class="form-check mb-3"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div>
