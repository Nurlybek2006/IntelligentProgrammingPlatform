@model Lesson
@{ ViewData["Title"] = Model.Title; }
<div class="page-heading lesson-heading"><div><p class="eyebrow">@A["Lesson_Details"]</p><h1>@Model.Title</h1><p>@Model.Summary</p></div></div>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">@A["Button_Edit"]</a>
    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">@A["Button_Delete"]</a>
    @if (Model.IsPublished) { <a class="btn btn-outline-primary" asp-area="" asp-controller="Lessons" asp-action="Details" asp-route-slug="@Model.Slug">@A["Lesson_OpenPublic"]</a> }
    <a class="btn btn-secondary" asp-action="Index">@A["Lesson_Back"]</a>
</div>
<section class="panel lesson-body">
    <h2 class="h4">@A["Lesson_Details"]</h2>
    <dl class="result-facts mb-4">
        <div><dt>@A["Field_Topic"]</dt><dd>@Model.Topic.Name</dd></div>
        <div><dt>@A["Field_Order"]</dt><dd>@Model.Order</dd></div>
        <div><dt>@A["Field_Published"]</dt><dd>@A[Model.IsPublished ? "Field_Published" : "Field_Unpublished"]</dd></div>
        <div><dt>@A["Field_Slug"]</dt><dd>@Model.Slug</dd></div>
        <div><dt>@A["Field_CreatedUtc"]</dt><dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
        <div><dt>@A["Field_CodeLanguage"]</dt><dd>@(Model.CodeLanguage == "cpp" ? "C++" : Model.CodeLanguage == "python" ? "Python" : A["Lesson_PlainText"].Value)</dd></div>
    </dl>
    <h2 class="h4">@A["Field_LessonContent"]</h2><div class="lesson-prose">@Model.Content</div>
    @if (!string.IsNullOrWhiteSpace(Model.CodeExample))
    {
        <h2 id="lesson-code-heading" class="h4 mt-4">@A["Field_CodeExample"]</h2>
        <p class="text-muted">@A["Lesson_CodeHelp"]</p>
        <pre class="source-code" tabindex="0" aria-labelledby="lesson-code-heading"><code>@Model.CodeExample</code></pre>
    }
</section>
